# Copiá este archivo como .env.local para desarrollo local (opcional).
#
# En Vercel NO necesitás crear esto a mano: al conectar una base de datos
# "Neon" (Storage -> Create Database -> Neon Postgres), Vercel inyecta
# automáticamente DATABASE_URL en el proyecto.
#
# Para desarrollo local con una base real, pegá acá la cadena de conexión
# que te da Neon/Vercel:

DATABASE_URL=

# Si NO definís DATABASE_URL, la app corre igual usando una base en memoria
# (los datos se pierden al reiniciar el server). Útil para probar el juego.
